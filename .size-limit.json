  {
    "name": "Default import (all functions)",
    "path": "dist/esm/index.js",
    "import": "{ uuid }",
    "limit": "3 kB"
  },
  {
    "name": "import { v4 }",
    "path": "dist/esm/index.js",
    "import": "{ v4 }",
    "limit": "2 kB"
  },
  {
    "name": "import { v7 }",
    "path": "dist/esm/index.js",
